# shellcheck shell=bash
# =============================================================
#  .config — shared paths, colours and logging helpers
#  Sourced by every script in scripts/  (not meant to be run).
# =============================================================
: "${ROOT_DIR:?ROOT_DIR must be set before sourcing .config}"

# ---- Absolute paths -------------------------------------------
RAW_FILE="$ROOT_DIR/data/raw/sensor_data.csv"
SAMPLE_FILE="$ROOT_DIR/data/raw/sample_data.txt"
CLEAN_FILE="$ROOT_DIR/data/processed/cleaned_data.csv"
FILTERED_FILE="$ROOT_DIR/data/processed/filtered_data.txt"
LOG_DIR="$ROOT_DIR/logs"
SYSTEM_LOG="$LOG_DIR/system.log"
MONITOR_LOG="$LOG_DIR/monitor.log"
ERROR_LOG="$LOG_DIR/error.log"
RESULTS_DIR="$ROOT_DIR/results"
SUMMARY_FILE="$RESULTS_DIR/summary.txt"
ALERTS_FILE="$RESULTS_DIR/alerts.txt"
REPORT_FILE="$RESULTS_DIR/report.txt"
BACKUP_DIR="$ROOT_DIR/backups"
export ROOT_DIR RAW_FILE SAMPLE_FILE CLEAN_FILE FILTERED_FILE LOG_DIR \
       SYSTEM_LOG MONITOR_LOG ERROR_LOG RESULTS_DIR SUMMARY_FILE \
       ALERTS_FILE REPORT_FILE BACKUP_DIR
mkdir -p "$LOG_DIR"

# ---- Colours (disabled when output is piped or NO_COLOR is set) --
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  RED=$'\033[1;31m'; GREEN=$'\033[1;32m'; YELLOW=$'\033[1;33m'
  BLUE=$'\033[1;34m'; CYAN=$'\033[1;36m'; DIM=$'\033[2m'
  BOLD=$'\033[1m';    RESET=$'\033[0m'
else
  RED=""; GREEN=""; YELLOW=""; BLUE=""; CYAN=""; DIM=""; BOLD=""; RESET=""
fi

# ---- Logging --------------------------------------------------
_log() {  # _log LEVEL MESSAGE  -> appends to logs/system.log
  printf '%s [%-5s] [%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" \
    "${SCRIPT_NAME:-script}" "$2" >> "$SYSTEM_LOG"
}
log_info()  { printf '  %s✔%s %s\n' "$GREEN" "$RESET" "$*"; _log INFO "$*"; }
log_warn()  { printf '  %s⚠%s %s\n' "$YELLOW" "$RESET" "$*"; _log WARN "$*"; }
log_error() {
  printf '  %s✖%s %s\n' "$RED" "$RESET" "$*" >&2
  _log ERROR "$*"
  printf '%s [ERROR] [%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" \
    "${SCRIPT_NAME:-script}" "$*" >> "$ERROR_LOG"
}
die() { log_error "$*"; exit 1; }

# Any unexpected failure is written to logs/error.log
trap 'log_error "Unexpected failure in ${SCRIPT_NAME:-script} (line ${LINENO})"' ERR

# ---- Pretty output --------------------------------------------
banner() {
  printf '%s' "$CYAN"
  printf '  ══════════════════════════════════════════════════════════\n'
  printf '   ♥  %s\n' "${PROJECT_NAME:-Heart Rate Monitoring System}"
  printf '      %s  |  v%s\n' "${COURSE:-Linux Project}" "${PROJECT_VERSION:-1.0.0}"
  printf '  ══════════════════════════════════════════════════════════\n'
  printf '%s\n' "$RESET"
}
title() { printf '\n%s━━ %s ━━%s\n' "$BOLD$CYAN" "$*" "$RESET"; }
step()  { printf '\n%s▶ %s%s\n' "$BOLD" "$*" "$RESET"; }

# ---- Guards ---------------------------------------------------
require_cmd()  { command -v "$1" >/dev/null 2>&1 || die "Required command not found: $1"; }
require_file() { [[ -f "$1" ]] || die "File not found: ${1#"$ROOT_DIR"/} — run the previous pipeline step first (try: make all)"; }
